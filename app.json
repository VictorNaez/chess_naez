{
  "expo": {
    "name": "chess_naez",
    "slug": "chess_naez",
    "scheme": "chess-naez",
    "version": "1.0.0",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.naez.chess"
    },
  "plugins": [
    "expo-dev-client",
    "expo-router",
    [
      "expo-splash-screen",
      {
        "image": "./assets/images/splash-icon.png",
        "imageWidth": 200,
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "dark": {
          "backgroundColor": "#000000"
        }
      }
    ],
    "expo-sqlite",
    "expo-font",
    "expo-web-browser",
    "expo-iap"
  ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "826a8c65-add8-4ca1-a1bf-7c96f4c4e3a2"
      }
    }
  }
}
