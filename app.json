{
  "expo": {
    "name": "Chess Naez",
    "slug": "chess_naez",
    "version": "0.1.0",
    "icon": "./assets/images/icon.png",
    "scheme": "chess-naez",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#2b2b2b",
    "primaryColor": "#4dabf7",
    "platforms": ["android"],
    "android": {
      "package": "com.naez.chess",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#070A11",
          "dark": {
            "backgroundColor": "#070A11"
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-web-browser",
      "expo-iap",
      "./plugins/withProgressBackup",
      "./plugins/withPlayGames",
      "./plugins/withLargeScreenConfigChanges"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "826a8c65-add8-4ca1-a1bf-7c96f4c4e3a2"
      },
      "googleWebClientId": "397420086797-t1t1n586jilvlppo7gtv2csj5bipc3h2.apps.googleusercontent.com",
      "pgsProjectId": "397420086797"
    }
  }
}
